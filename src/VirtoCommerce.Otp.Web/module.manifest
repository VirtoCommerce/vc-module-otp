<?xml version="1.0" encoding="utf-8"?>
<module>
  <id>VirtoCommerce.OTP</id>
  <version>3.1001.0</version>
  <version-tag></version-tag>

  <platformVersion>3.1083.0</platformVersion>
  <dependencies>
    <dependency id="VirtoCommerce.Customer" version="3.1011.1" />
    <dependency id="VirtoCommerce.Notifications" version="3.1018.0" />
    <dependency id="VirtoCommerce.Store" version="3.1011.0-alpha.809-vcst-6169" />
  </dependencies>

  <title>OTP Sign-In</title>
  <description>Enables customers to sign in to the storefront with a one-time code emailed to them, instead of a password.</description>

  <authors>
    <author>Virto Commerce</author>
  </authors>
  <owners>
    <owner>Virto Commerce</owner>
  </owners>

  <projectUrl>https://github.com/VirtoCommerce/vc-module-otp</projectUrl>
  <iconUrl>Modules/$(VirtoCommerce.OTP)/Content/logo.svg</iconUrl>
  <requireLicenseAcceptance>false</requireLicenseAcceptance>

  <assemblyFile>VirtoCommerce.Otp.Web.dll</assemblyFile>
  <moduleType>VirtoCommerce.Otp.Web.Module, VirtoCommerce.Otp.Web</moduleType>

  <releaseNotes>First version.</releaseNotes>
  <copyright>Copyright © 2026 Virto Commerce. All rights reserved</copyright>
  <tags>extension module</tags>
  <useFullTypeNameInSwagger>false</useFullTypeNameInSwagger>
</module>
